{
  "name": "vanish",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Vanish — anonymous, end-to-end encrypted, ephemeral chat rooms on Cloudflare.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:app": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.build.json && tsc -p functions/tsconfig.json && tsc -p room-worker/tsconfig.json",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2026-07-17",
    "pages:deploy": "wrangler pages deploy dist",
    "worker:deploy": "wrangler deploy -c room-worker/wrangler.toml",
    "worker:dev": "wrangler dev -c room-worker/wrangler.toml",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "verify": "tsx tests/manual/verify.ts"
  },
  "dependencies": {
    "lucide-react": "^1.29.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  }
}
