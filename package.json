{
  "name": "vanish",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Vanish — anonymous, end-to-end encrypted, ephemeral chat rooms on Cloudflare.",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:app": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.build.json && tsc -p functions/tsconfig.json && tsc -p room-worker/tsconfig.json",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2026-07-17",
    "pages:deploy": "wrangler pages deploy dist",
    "worker:deploy": "wrangler deploy -c room-worker/wrangler.toml",
    "worker:dev": "wrangler dev -c room-worker/wrangler.toml",
    "deploy": "npm run worker:deploy && npm run build && npm run pages:deploy",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "verify": "tsx tests/manual/verify.ts"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^20.11.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.11",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "nanoid": "3.3.17"
  }
}
